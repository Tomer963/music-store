{
  "name": "music-store-backend",
  "version": "1.0.0",
  "description": "Backend for online music store",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js"
  },
  "engines": {
    "node": ">=16.x"
  },
  "keywords": [
    "music",
    "store",
    "nodejs",
    "mongodb",
    "express"
  ],
  "author": "Tomer Dore",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.1",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3"
  },
  "devDependencies": {
    "cross-env": "^10.0.0",
    "nodemon": "^3.0.1"
  },
  "nodemonConfig": {
    "delay": 2500,
    "verbose": true,
    "ignore": [
      "*.test.js",
      "*.spec.js",
      ".git",
      "node_modules/**/node_modules"
    ],
    "watch": [
      "server.js",
      "src/**/*.js"
    ],
    "ext": "js,json",
    "env": {
      "NODE_ENV": "development"
    },
    "signal": "SIGTERM",
    "events": {
      "restart": "echo 'Restarting server...'",
      "crash": "echo 'Server crashed - waiting for file changes before restart'"
    }
  }
}